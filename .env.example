# Own server: public domain for HTTPS (Caddy gets a free Let's Encrypt certificate).
# No domain? Use your server IP via sslip.io: 203.0.113.7 → 203-0-113-7.sslip.io
DOMAIN=

# All keys are server-side only. Never prefix them with NEXT_PUBLIC_.

# Search: Tavily (free "Researcher" plan, 1,000 credits/month, no card) — https://app.tavily.com
TAVILY_API_KEY=

# LLM: any OpenAI-compatible Chat Completions API. Default: Groq free tier — https://console.groq.com/keys
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
# One model or a comma-separated fallback chain (free tiers limit each model separately)
LLM_MODEL=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b
# Parallel LLM calls (keep low on free tiers)
LLM_CONCURRENCY=3

# Public service protection
RESEARCH_PER_IP_PER_HOUR=3
RESEARCH_DAILY_BUDGET=40
CAMPAIGN_PER_IP_PER_HOUR=12
MAX_CONCURRENT_RESEARCH=2
# Extra origins allowed to call the API (GitHub Pages origin is always allowed)
ALLOWED_ORIGINS=https://fluxx102.github.io

# Frontend (only for the static GitHub Pages build): public URL of the deployed backend
# NEXT_PUBLIC_API_BASE=https://trendwatcher.vercel.app
